def removes_Head(head):
    if head is None:
        return None
    head = head.next
    return head

def removes_tail(head):
    if head is None or head.next is None:
        return None
    
    temp = head
    while temp.next.next is not None:
        temp = temp.next
    
    temp.next = None
    return head

def removeK(head,k):
    if head is None:
        return head
    if k == 1:
        temp = head
        head = head.next
        # del temp
        return head
    
    cnt = 0
    temp = head
    prev = None
    while temp is not None:
        cnt += 1
        if cnt == k:
            prev.next = prev.next.next
            del(temp)
            break
        prev = temp
        temp = temp.next
    
    return head

def removeElement(head,ele):
    if head is None:
        return head
    if head.data == ele:
        temp = head
        head = head.next
        return head
    
    temp = head
    prev = None
    while temp is not None:
        if temp.data == ele:
            prev.next = prev.next.next
            del(temp)
            break
        prev = temp
        temp = temp.next
    
    return head
    
    
def insertHead(head,data):
    temp = Node(data)
    temp.next = head
    return temp

def insertTail(head,x):
    data = Node(x)
    if head is None:
        return data
    temp = head
    while temp.next is not None:
        temp = temp.next
    temp.next = data
    return head

def insertK(head,ele,k):
    if head is None:
        if k == 1:
            return Node(ele)
        else:
            return head
        
    if k == 1:
        temp = Node(ele)
        temp.next = head
        return temp
    
    cnt = 0
    temp = head
    while temp is not None:
        cnt += 1
        if cnt == k - 1:
            x = Node(ele)
            x.next = temp.next
            temp.next = x
            
            return head
        temp = temp.next
            
def insertBeforeValue(head,ele,val):
    if head is None:
        return None
        
    if head.data == val:
        temp = Node(ele)
        temp.next = head
        return temp
  
    temp = head
    while temp.next is not None:
        if temp.next.data == val:
            x = Node(ele)
            x.next = temp.next
            temp.next = x
            
            return head
        temp = temp.next
        

