
class Node:
    def __init__(self,data,next=None):
        self.data = data
        self.next = next
        
def array_to_linkedlist(arr):
    if not arr:
        return None
    
    head = Node(arr[0])
    mover = head
    
    for i in range(1,len(arr)):
        mover.next = Node(arr[i])
        mover = mover.next
        
    return head

