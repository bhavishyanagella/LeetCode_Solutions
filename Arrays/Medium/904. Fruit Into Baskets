class Solution(object):
    def totalFruit(self, fruits):
        n = len(fruits)
        max_fruits = 0
        mp = {}
        left = 0

        for right in range(n):
            mp[fruits[right]] = mp.get(fruits[right],0)+1

            while len(mp) >2:
                mp[fruits[left]] -= 1

                if mp[fruits[left]] == 0:
                    del mp[fruits[left]]
                left += 1

            max_fruits = max(max_fruits,right-left+1)
        return max_fruits
        
